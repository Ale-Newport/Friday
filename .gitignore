# Local, per-developer signing/config overrides (see Config/Local.xcconfig.example)
Config/Local.xcconfig

# Picovoice binaries and models are fetched by Scripts/fetch-porcupine.sh
# (pinned + checksum-verified). Only the lock file, README and LICENSE are committed.
Vendor/Porcupine/lib/
Vendor/Porcupine/models/
Vendor/Porcupine/keywords/
Vendor/Porcupine/downloads/

# sherpa-onnx binaries and models are fetched by Scripts/fetch-sherpa.sh (pinned + checksum-verified).
# Only the lock file and the licences are committed.
Vendor/SherpaOnnx/lib/
Vendor/SherpaOnnx/models/
Vendor/SherpaOnnx/.verified
Vendor/SherpaOnnx/.installed.sha256

# Secrets must never be committed
*.accesskey
.env
.env.*
