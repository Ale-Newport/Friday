# Friday reads no .env file by itself: copy what you need into your shell or the Xcode scheme's environment.
# Real credentials belong in the macOS Keychain, which is where Friday stores them (Settings ▸ Intelligence).
# Never commit a filled-in copy of this file; `.env` and `.env.*` are git-ignored.

# ── Wake word (optional) ─────────────────────────────────────────────────────
# Only for the optional Picovoice Porcupine engine. The default sherpa-onnx engine needs no key.
# Free key: https://console.picovoice.ai/  (Friday can also store it in the Keychain from Settings.)
PICOVOICE_ACCESS_KEY=

# ── Python sidecar (standalone use; Friday.app sets these itself) ────────────
# Each variable is read as FRIDAY_<NAME> first, then the legacy JARVIS_<NAME>.
FRIDAY_PORT=0                 # 0 = pick a free loopback port; the sidecar only ever binds 127.0.0.1
FRIDAY_TOKEN=                 # bearer token for the local API; generated and printed when empty
FRIDAY_DATA_DIR=              # defaults to ~/Library/Application Support/Friday/sidecar
FRIDAY_DOWNLOADS_DIR=         # where the browser agent may save files (asks first)
FRIDAY_LOG=INFO               # log level: DEBUG, INFO, WARNING, ERROR
JARVIS_CHROME_FLAGS=          # extra Chrome command-line flags for the browser agent

# ── Local models through Ollama (optional) ───────────────────────────────────
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=16384
